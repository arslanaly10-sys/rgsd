# Postgres connection. Local: postgres://rgs:rgs@localhost:5432/rgs_onesite
# Supabase: use the "Session pooler" connection string from Project Settings > Database.
DATABASE_URL=postgres://rgs:rgs@localhost:5432/rgs_onesite
# 1 when running against plain local Postgres (applies the Supabase role shim).
DB_LOCAL=1

# Signs demo session cookies. Generate with: openssl rand -base64 32
AUTH_SECRET=change-me
# demo = persona picker (sample data). supabase = Supabase Auth (later).
AUTH_MODE=demo

# AI: mock runs deterministic agents with no key. live calls Claude.
AI_MODE=mock
# provider when AI_MODE=live: anthropic | gateway
AI_PROVIDER=anthropic
ANTHROPIC_API_KEY=
AI_GATEWAY_API_KEY=
AI_MODEL_SMART=claude-opus-5-5
AI_MODEL_FAST=claude-haiku-5-5
