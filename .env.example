# Postgres connection. Local: postgres://rgs:rgs@localhost:5432/rgs_onesite
# Supabase: use the "Session pooler" connection string from Project Settings > Database.
DATABASE_URL=postgres://rgs:rgs@localhost:5432/rgs_onesite
# 1 when running against plain local Postgres (applies the Supabase role shim).
DB_LOCAL=1

# Signs sessions and hashes sign-in codes. Generate with: openssl rand -base64 32
AUTH_SECRET=change-me
# demo = persona picker + email codes (codes shown on screen). otp = production: email code sign-in only, invitations, MFA.
AUTH_MODE=demo
# Roles that must use an authenticator app when AUTH_MODE=otp.
MFA_REQUIRED_ROLES=admin,finance
# Public URL used in emails and invitation links.
APP_URL=http://localhost:3100
# Protects /api/workflows/tick and /api/watchers/run (Vercel Cron sends it as a Bearer token).
CRON_SECRET=

# Outbound channels. Leave empty to log messages in the admin outbox instead of sending.
RESEND_API_KEY=
EMAIL_FROM=RGS OneSite <no-reply@rgsksa.com>
WHATSAPP_TOKEN=
WHATSAPP_PHONE_ID=
UNIFONIC_APP_SID=
UNIFONIC_SENDER=RGS

# AI: mock runs deterministic agents with no key. live calls Claude.
AI_MODE=mock
# provider when AI_MODE=live: anthropic | gateway
AI_PROVIDER=anthropic
ANTHROPIC_API_KEY=
AI_GATEWAY_API_KEY=
AI_MODEL_SMART=claude-opus-5-5
AI_MODEL_FAST=claude-haiku-5-5
